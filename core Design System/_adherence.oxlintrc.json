{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/dream/**",
              "components/texture/**",
              "components/window/**",
              "ui_kits/archive/**",
              "ui_kits/blog/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:MS Sans Serif|Pixelify Sans|VT323|Tinos))/i]",
        "message": "Font not provided by the design system. Available: MS Sans Serif, Pixelify Sans, VT323, Tinos."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|glow|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, glow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|label|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: variant, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:dashed|solid|block)$/]",
        "message": "<Divider> variant must be one of 'dashed' | 'solid' | 'block'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glow'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|intensity|inline|children|key|ref|className|style|children)$/]",
        "message": "<Glow> doesn't accept that prop. Declared props: color, intensity, inline, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glow'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:peach|rose|pool)$/]",
        "message": "<Glow> color must be one of 'peach' | 'rose' | 'pool'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GrainOverlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:opacity|blendMode|key|ref|className|style|children)$/]",
        "message": "<GrainOverlay> doesn't accept that prop. Declared props: opacity, blendMode."
      },
      {
        "selector": "JSXOpeningElement[name.name='Halo'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|size|children|key|ref|className|style|children)$/]",
        "message": "<Halo> doesn't accept that prop. Declared props: color, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Halo'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:peach|rose|pool|sodium)$/]",
        "message": "<Halo> color must be one of 'peach' | 'rose' | 'pool' | 'sodium'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|label|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: size, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|mono|style|wrapStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, mono, style, wrapStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|speed|rainbow|tone|repeat|style|key|ref|className|style|children)$/]",
        "message": "<Marquee> doesn't accept that prop. Declared props: children, speed, rainbow, tone, repeat, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|paper)$/]",
        "message": "<Marquee> tone must be one of 'ink' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OverexposedText'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|size|color|glow|children|key|ref|className|style|children)$/]",
        "message": "<OverexposedText> doesn't accept that prop. Declared props: as, size, color, glow, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='OverexposedText'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:paper|frost|bondi|chrome|bubblegum|peach|rose|sodium|tile)$/]",
        "message": "<OverexposedText> color must be one of 'paper' | 'frost' | 'bondi' | 'chrome' | 'bubblegum' | 'peach' | 'rose' | 'sodium' | 'tile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OverexposedText'] > JSXAttribute[name.name='glow'] > Literal[value!=/^(?:bondi|chrome|bubblegum|pool|peach|rose)$/]",
        "message": "<OverexposedText> glow must be one of 'bondi' | 'chrome' | 'bubblegum' | 'pool' | 'peach' | 'rose'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|bracketed|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: variant, bracketed, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TilePattern'] > JSXAttribute > JSXIdentifier[name!=/^(?:pattern|size|opacity|blendMode|fixed|children|key|ref|className|style|children)$/]",
        "message": "<TilePattern> doesn't accept that prop. Declared props: pattern, size, opacity, blendMode, fixed, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TilePattern'] > JSXAttribute[name.name='pattern'] > Literal[value!=/^(?:cool|warm|caustic|grain)$/]",
        "message": "<TilePattern> pattern must be one of 'cool' | 'warm' | 'caustic' | 'grain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|tone|onClose|children|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: title, tone, onClose, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Window'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|active|size|bodyTone|dense|decorativeStripes|onClose|onMinimize|status|children|key|ref|className|style|children)$/]",
        "message": "<Window> doesn't accept that prop. Declared props: title, active, size, bodyTone, dense, decorativeStripes, onClose, onMinimize, status, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Window'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Window> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Window'] > JSXAttribute[name.name='bodyTone'] > Literal[value!=/^(?:paper|pool|dream)$/]",
        "message": "<Window> bodyTone must be one of 'paper' | 'pool' | 'dream'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
