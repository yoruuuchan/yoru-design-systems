{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/analog/**",
              "components/editorial/**",
              "components/image/**",
              "components/masthead/**",
              "components/ui/**",
              "slides/**",
              "ui_kits/journal/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:EB Garamond|IBM Plex Sans|IBM Plex Mono|Caveat|Noto Serif SC|Noto Sans SC))/i]",
        "message": "Font not provided by the design system. Available: EB Garamond, IBM Plex Sans, IBM Plex Mono, Caveat, Noto Serif SC, Noto Sans SC."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|emphasis|standfirst|size|align|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<ArticleHeader> doesn't accept that prop. Declared props: kicker, title, emphasis, standfirst, size, align, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleHeader'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<ArticleHeader> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleHeader'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<ArticleHeader> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|href|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, href, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|quiet|accent)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline' | 'quiet' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Columns'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|split|gap|rule|align|collapseAt|style|key|ref|className|style|children)$/]",
        "message": "<Columns> doesn't accept that prop. Declared props: children, split, gap, rule, align, collapseAt, style."
