{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "ui_kits/mobile_app/**",
              "ui_kits/web_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Press Start 2P|VT323|DotGothic16|Major Mono Display))/i]",
        "message": "Font not provided by the design system. Available: Press Start 2P, VT323, DotGothic16, Major Mono Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:magenta|cyan|blue|success|warning|danger|muted)$/]",
        "message": "<Badge> variant must be one of 'magenta' | 'cyan' | 'blue' | 'success' | 'warning' | 'danger' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|glow|fullWidth|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, glow, fullWidth, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|cyan|blue|blue-outline|ghost|outline|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'cyan' | 'blue' | 'blue-outline' | 'ghost' | 'outline' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|glow|title|meta|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, glow, title, meta, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|raised|neon|cyan|blue)$/]",
        "message": "<Card> variant must be one of 'default' | 'raised' | 'neon' | 'cyan' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlitchText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|size|as|style|key|ref|className|style|children)$/]",
        "message": "<GlitchText> doesn't accept that prop. Declared props: children, color, size, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|prefix|icon|value|onChange|placeholder|type|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, prefix, icon, value, onChange, placeholder, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|variant|label|style|key|ref|className|style|children)$/]",
        "message": "<Progress> doesn't accept that prop. Declared props: value, max, variant, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:magenta|cyan|blue)$/]",
        "message": "<Progress> variant must be one of 'magenta' | 'cyan' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScanlineOverlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:intensity|grain|children|style|key|ref|className|style|children)$/]",
        "message": "<ScanlineOverlay> doesn't accept that prop. Declared props: intensity, grain, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScanlineOverlay'] > JSXAttribute[name.name='intensity'] > Literal[value!=/^(?:soft|medium|strong)$/]",
        "message": "<ScanlineOverlay> intensity must be one of 'soft' | 'medium' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: label, value."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
