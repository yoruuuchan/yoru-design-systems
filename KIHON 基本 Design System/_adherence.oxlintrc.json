{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/data/**",
              "components/frame/**",
              "components/type/**",
              "ui_kits/landscape/**",
              "ui_kits/portrait/**",
              "ui_kits/shared/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Han Sans SC|Instrument Sans|B612 Mono))/i]",
        "message": "Font not provided by the design system. Available: Source Han Sans SC, Instrument Sans, B612 Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Arc'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|step|size|thickness|label|style|key|ref|className|style|children)$/]",
        "message": "<Arc> doesn't accept that prop. Declared props: value, step, size, thickness, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|step|direction|thickness|cap|style|key|ref|className|style|children)$/]",
        "message": "<Bar> doesn't accept that prop. Declared props: value, step, direction, thickness, cap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bar'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:up|right)$/]",
        "message": "<Bar> direction must be one of 'up' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: state, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:neutral|selected|active|before|after)$/]",
        "message": "<Chip> state must be one of 'neutral' | 'selected' | 'active' | 'before' | 'after'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Knurl'] > JSXAttribute > JSXIdentifier[name!=/^(?:progress|tone|style|key|ref|className|style|children)$/]",
        "message": "<Knurl> doesn't accept that prop. Declared props: progress, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Knurl'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:line|strong)$/]",
        "message": "<Knurl> tone must be one of 'line' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|index|rule|style|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: children, index, rule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Numeral'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|tick|color|style|key|ref|className|style|children)$/]",
        "message": "<Numeral> doesn't accept that prop. Declared props: value, unit, tick, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Placeholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|ratio|style|key|ref|className|style|children)$/]",
        "message": "<Placeholder> doesn't accept that prop. Declared props: label, ratio, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ramp'] > JSXAttribute > JSXIdentifier[name!=/^(?:labels|style|key|ref|className|style|children)$/]",
        "message": "<Ramp> doesn't accept that prop. Declared props: labels, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:vertical|tone|ticks|style|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: vertical, tone, ticks, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:line|strong|accent)$/]",
        "message": "<Rule> tone must be one of 'line' | 'strong' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stage'] > JSXAttribute > JSXIdentifier[name!=/^(?:format|theme|grain|safe|falloff|children|style|key|ref|className|style|children)$/]",
        "message": "<Stage> doesn't accept that prop. Declared props: format, theme, grain, safe, falloff, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stage'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:landscape|portrait)$/]",
        "message": "<Stage> format must be one of 'landscape' | 'portrait'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stage'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:gin|kuro)$/]",
        "message": "<Stage> theme must be one of 'gin' | 'kuro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Surface'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|emphasized|tone|pad|style|children|key|ref|className|style|children)$/]",
        "message": "<Surface> doesn't accept that prop. Declared props: level, emphasized, tone, pad, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Surface'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:plate|card|control|well)$/]",
        "message": "<Surface> level must be one of 'plate' | 'card' | 'control' | 'well'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Surface'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent)$/]",
        "message": "<Surface> tone must be one of 'neutral' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|color|children|style|key|ref|className|style|children)$/]",
        "message": "<Text> doesn't accept that prop. Declared props: role, color, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:display|title|subtitle|body|caption)$/]",
        "message": "<Text> role must be one of 'display' | 'title' | 'subtitle' | 'body' | 'caption'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
